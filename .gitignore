# Terraform working directory (generated by terraform init)
**/.terraform/
terraform.d/

# Terraform state files (stored in S3 — never commit locally)
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~
